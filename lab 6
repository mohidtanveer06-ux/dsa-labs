        "class Gradebook:\n",
        "    def __init__(self, initial_capacity=4):\n",
        "        self.capacity = initial_capacity\n",
        "        self.size = 0\n",
        "        self.array = [None] * self.capacity\n",
        "\n",
        "    def _resize(self):\n",
        "        new_capacity = self.capacity * 2\n",
        "        new_array = [None] * new_capacity\n",
        "        for i in range(self.size):\n",
        "            new_array[i] = self.array[i]\n",
        "        print(f\"\\n[System] Array full! Resizing capacity from {self.capacity} to {new_capacity}.\")\n",
        "        self.array = new_array\n",
        "        self.capacity = new_capacity\n",
        "\n",
        "    def add_score(self, score):\n",
        "        if self.size == self.capacity:\n",
        "            self._resize()\n",
        "        self.array[self.size] = score\n",
        "        self.size += 1\n",
        "        print(f\"Added score: {score}. Current Size: {self.size}/{self.capacity}\")\n",
        "\n",
        "    def delete_at(self, index):\n",
        "        if index < 0 or index >= self.size:\n",
        "            print(f\"Error: Index {index} is out of bounds!\")\n",
        "            return None\n",
        "        deleted_value = self.array[index]\n",
        "        for i in range(index, self.size - 1):\n",
        "            self.array[i] = self.array[i + 1]\n",
        "        self.array[self.size - 1] = None\n",
        "        self.size -= 1\n",
        "        print(f\"Deleted score {deleted_value} at index {index}.\")\n",
        "        return deleted_value\n",
        "\n",
        "    def search_score(self, target):\n",
        "        for i in range(self.size):\n",
        "            if self.array[i] == target:\n",
        "                return i\n",
        "        return -1\n",
        "\n",
        "    def get_valid_scores(self):\n",
        "        return [self.array[i] for i in range(self.size)]\n",
        "\n",
        "    def calculate_average(self):\n",
        "        if self.size == 0:\n",
        "            return 0\n",
        "        return sum(self.get_valid_scores()) / self.size\n",
        "\n",
        "    def get_highest(self):\n",
        "        if self.size == 0:\n",
        "            return None\n",
        "        highest = self.array[0]\n",
        "        for i in range(1, self.size):\n",
        "            if self.array[i] > highest:\n",
        "                highest = self.array[i]\n",
        "        return highest\n",
        "\n",
        "    def get_lowest(self):\n",
        "        if self.size == 0:\n",
        "            return None\n",
        "        lowest = self.array[0]\n",
        "        for i in range(1, self.size):\n",
        "            if self.array[i] < lowest:\n",
        "                lowest = self.array[i]\n",
        "        return lowest\n",
        "\n",
        "    def calculate_median(self):\n",
        "        if self.size == 0:\n",
        "            return None\n",
        "        scores = sorted(self.get_valid_scores())\n",
        "        n = len(scores)\n",
        "        if n % 2 == 1:\n",
        "            return scores[n // 2]\n",
        "        else:\n",
        "            return (scores[(n // 2) - 1] + scores[n // 2]) / 2.0\n",
        "\n",
        "    def display(self):\n",
        "        print(f\"Scores: {self.get_valid_scores()} | Internal Storage: {self.array[:self.capacity]}\")\n",
        "\n",
        "gb = Gradebook(initial_capacity=4)\n",
        "gb.add_score(85)\n",
        "gb.add_score(92)\n",
        "gb.add_score(78)\n",
        "gb.add_score(90)\n",
        "gb.display()\n",
        "\n",
        "gb.add_score(65)\n",
        "gb.add_score(88)\n",
        "gb.display()\n",
        "\n",
        "print(f\"Class Average : {gb.calculate_average():.2f}\")\n",
        "print(f\"Highest Score : {gb.get_highest()}\")\n",
        "print(f\"Lowest Score  : {gb.get_lowest()}\")\n",
        "print(f\"Median Score  : {gb.calculate_median()}\")\n",
        "\n",
        "idx = gb.search_score(90)\n",
        "if idx != -1:\n",
        "    print(f\"Score 90 found at index: {idx}\")\n",
        "\n",
        "gb.delete_at(2)\n",
        "gb.display()\n",
        "\n",
        "print(f\"New Class Average : {gb.calculate_average():.2f}\")\n",
        "print(f\"New Median Score  : {gb.calculate_median()}\")"
      ],
