        "class SongNode:\n",
        "    def __init__(self, song_id, title, artist, duration):\n",
        "        self.song_id = song_id\n",
        "        self.title = title\n",
        "        self.artist = artist\n",
        "        self.duration = duration\n",
        "        self.next = None\n",
        "        self.prev = None\n",
        "\n",
        "class PlaylistManager:\n",
        "    def __init__(self):\n",
        "        self.head = None\n",
        "        self.tail = None\n",
        "        self.current = None\n",
        "\n",
        "    def insert_at_beginning(self, song_id, title, artist, duration):\n",
        "        new_node = SongNode(song_id, title, artist, duration)\n",
        "        if not self.head:\n",
        "            self.head = new_node\n",
        "            self.tail = new_node\n",
        "            self.current = new_node\n",
        "        else:\n",
        "            new_node.next = self.head\n",
        "            self.head.prev = new_node\n",
        "            self.head = new_node\n",
        "        print(f\"Inserted at beginning: {title}\")\n",
        "\n",
        "    def insert_at_end(self, song_id, title, artist, duration):\n",
        "        new_node = SongNode(song_id, title, artist, duration)\n",
        "        if not self.head:\n",
        "            self.head = new_node\n",
        "            self.tail = new_node\n",
        "            self.current = new_node\n",
        "        else:\n",
        "            new_node.prev = self.tail\n",
        "            self.tail.next = new_node\n",
        "            self.tail = new_node\n",
        "        print(f\"Inserted at end: {title}\")\n",
        "\n",
        "    def insert_after(self, target_id, song_id, title, artist, duration):\n",
        "        temp = self.head\n",
        "        while temp:\n",
        "            if temp.song_id == target_id:\n",
        "                new_node = SongNode(song_id, title, artist, duration)\n",
        "                new_node.next = temp.next\n",
        "                new_node.prev = temp\n",
        "                if temp.next:\n",
        "                    temp.next.prev = new_node\n",
        "                else:\n",
        "                    self.tail = new_node\n",
        "                temp.next = new_node\n",
        "                print(f\"Inserted {title} after song ID {target_id}\")\n",
        "                return\n",
        "            temp = temp.next\n",
        "        print(f\"Song with ID {target_id} not found.\")\n",
        "\n",
        "    def play_next(self, loop=False):\n",
        "        if not self.current:\n",
        "            print(\"Playlist is empty.\")\n",
        "            return\n",
        "        if self.current.next:\n",
        "            self.current = self.current.next\n",
        "        elif loop:\n",
        "            self.current = self.head\n",
        "        else:\n",
        "            print(\"Reached the end of the playlist.\")\n",
        "            return\n",
        "        print(f\"Playing: {self.current.title} by {self.current.artist}\")\n",
        "\n",
        "    def play_previous(self, loop=False):\n",
        "        if not self.current:\n",
        "            print(\"Playlist is empty.\")\n",
        "            return\n",
        "        if self.current.prev:\n",
        "            self.current = self.current.prev\n",
        "        elif loop:\n",
        "            self.current = self.tail\n",
        "        else:\n",
        "            print(\"Reached the beginning of the playlist.\")\n",
        "            return\n",
        "        print(f\"Playing: {self.current.title} by {self.current.artist}\")\n",
        "\n",
        "    def reverse_playlist(self):\n",
        "        if not self.head:\n",
        "            print(\"Cannot reverse an empty playlist.\")\n",
        "            return\n",
        "        temp = None\n",
        "        current = self.head\n",
        "        self.tail = self.head\n",
        "        while current:\n",
        "            temp = current.prev\n",
        "            current.prev = current.next\n",
        "            current.next = temp\n",
        "            current = current.prev\n",
        "        if temp:\n",
        "            self.head = temp.prev\n",
        "        self.current = self.head\n",
        "        print(\"Playlist successfully reversed in-place.\")\n",
        "\n",
        "    def display(self):\n",
        "        if not self.head:\n",
        "            print(\"Playlist is empty.\")\n",
        "            return\n",
        "        temp = self.head\n",
        "        songs = []\n",
        "        while temp:\n",
        "            songs.append(f\"[{temp.song_id}] {temp.title}\")\n",
        "            temp = temp.next\n",
        "        print(\" -> \".join(songs))\n",
        "\n",
        "manager = PlaylistManager()\n",
        "manager.display()\n",
        "manager.reverse_playlist()\n",
        "\n",
        "manager.insert_at_end(1, \"Song A\", \"Artist X\", 180)\n",
        "manager.display()\n",
        "manager.reverse_playlist()\n",
        "manager.display()\n",
        "\n",
        "manager.insert_at_beginning(2, \"Song B\", \"Artist Y\", 200)\n",
        "manager.insert_at_end(3, \"Song C\", \"Artist Z\", 220)\n",
        "manager.display()\n",
        "\n",
        "manager.insert_after(2, 4, \"Song D\", \"Artist W\", 190)\n",
        "manager.display()\n",
        "\n",
        "print(f\"Currently Playing: {manager.current.title}\")\n",
        "manager.play_next()\n",
        "manager.play_next()\n",
        "manager.play_next()\n",
        "manager.play_next(loop=True)\n",
        "\n",
        "manager.play_previous()\n",
        "manager.play_previous(loop=True)\n",
        "\n",
        "manager.reverse_playlist()\n",
        "manager.display()"
