        "class Stack:\n",
        "    def __init__(self):\n",
        "        self.items = []\n",
        "\n",
        "    def push(self, item):\n",
        "        self.items.append(item)\n",
        "\n",
        "    def pop(self):\n",
        "        if self.is_empty():\n",
        "            return None\n",
        "        return self.items.pop()\n",
        "\n",
        "    def peek(self):\n",
        "        if self.is_empty():\n",
        "            return None\n",
        "        return self.items[-1]\n",
        "\n",
        "    def is_empty(self):\n",
        "        return len(self.items) == 0\n",
        "\n",
        "    def size(self):\n",
        "        return len(self.items)\n",
        "\n",
        "class Queue:\n",
        "    def __init__(self):\n",
        "        self.items = []\n",
        "\n",
        "    def enqueue(self, item):\n",
        "        self.items.append(item)\n",
        "\n",
        "    def dequeue(self):\n",
        "        if self.is_empty():\n",
        "            return None\n",
        "        return self.items.pop(0)\n",
        "\n",
        "    def peek(self):\n",
        "        if self.is_empty():\n",
        "            return None\n",
        "        return self.items[0]\n",
        "\n",
        "    def is_empty(self):\n",
        "        return len(self.items) == 0\n",
        "\n",
        "    def size(self):\n",
        "        return len(self.items)\n",
        "\n",
        "class TextSimulator:\n",
        "    def __init__(self):\n",
        "        self.current_text = \"\"\n",
        "        self.undo_stack = Stack()\n",
        "        self.redo_stack = Stack()\n",
        "        self.print_queue = Queue()\n",
        "\n",
        "    def write_text(self, text):\n",
        "        self.undo_stack.push(self.current_text)\n",
        "        self.redo_stack = Stack()\n",
        "        self.current_text += text\n",
        "        print(f\"Wrote: \\'{text}\\' | Current Text: \\'{self.current_text}\\'\")\n",
        "\n",
        "    def undo(self):\n",
        "        if self.undo_stack.is_empty():\n",
        "            print(\"Nothing to undo!\")\n",
        "            return\n",
        "        self.redo_stack.push(self.current_text)\n",
        "        self.current_text = self.undo_stack.pop()\n",
        "        print(f\"Undo Action | Current Text: \\'{self.current_text}\\'\")\n",
        "\n",
        "    def redo(self):\n",
        "        if self.redo_stack.is_empty():\n",
        "            print(\"Nothing to redo!\")\n",
        "            return\n",
        "        self.undo_stack.push(self.current_text)\n",
        "        self.current_text = self.redo_stack.pop()\n",
        "        print(f\"Redo Action | Current Text: \\'{self.current_text}\\'\")\n",
        "\n",
        "    def add_to_print_queue(self):\n",
        "        if not self.current_text:\n",
        "            print(\"Cannot queue empty document.\")\n",
        "            return\n",
        "        self.print_queue.enqueue(self.current_text)\n",
        "        print(f\"Queued for print: \\'{self.current_text}\\'\")\n",
        "\n",
        "    def process_print_queue(self):\n",
        "        print(\"\\n--- Processing Print Queue ---\")\n",
        "        while not self.print_queue.is_empty():\n",
        "            doc = self.print_queue.dequeue()\n",
        "            print(f\"Printing Document: \\'{doc}\\'\")\n",
        "        print(\"All pending print tasks completed.\")\n",
        "\n",
        "simulator = TextSimulator()\n",
        "\n",
        "simulator.write_text(\"Hello \")\n",
        "simulator.write_text(\"World \")\n",
        "simulator.write_text(\"This \")\n",
        "simulator.write_text(\"Is \")\n",
        "simulator.write_text(\"DSA \")\n",
        "\n",
        "simulator.add_to_print_queue()\n",
        "\n",
        "simulator.undo()\n",
        "simulator.undo()\n",
        "\n",
        "simulator.add_to_print_queue()\n",
        "\n",
        "simulator.redo()\n",
        "\n",
        "simulator.add_to_print_queue()\n",
        "\n",
        "simulator.process_print_queue()"
