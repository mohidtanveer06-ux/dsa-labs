        "class MinStack:\n",
        "    def __init__(self):\n",
        "        self.items = []\n",
        "        self.min_items = []\n",
        "\n",
        "    def is_empty(self):\n",
        "        return len(self.items) == 0\n",
        "\n",
        "    def push(self, item):\n",
        "        self.items.append(item)\n",
        "        if len(self.min_items) == 0 or item <= self.min_items[-1]:\n",
        "            self.min_items.append(item)\n",
        "\n",
        "    def pop(self):\n",
        "        if not self.is_empty():\n",
        "            popped = self.items.pop()\n",
        "            if popped == self.min_items[-1]:\n",
        "                self.min_items.pop()\n",
        "            return popped\n",
        "        return None\n",
        "\n",
        "    def peek(self):\n",
        "        if not self.is_empty():\n",
        "            return self.items[-1]\n",
        "        return None\n",
        "\n",
        "    def get_min(self):\n",
        "        if len(self.min_items) > 0:\n",
        "            return self.min_items[-1]\n",
        "        return None\n",
        "\n",
